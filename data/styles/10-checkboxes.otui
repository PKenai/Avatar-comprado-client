CheckBox < UICheckBox
  size: 16 16
  text-align: left
  text-offset: 18 1
  color: #8892a4
  image-color: #2a3450
  image-rect: 0 0 16 16
  image-source: /images/ui/checkbox

  $hover !disabled:
    color: #e8ecf1
    image-color: #334060

  $!checked:
    image-clip: 0 0 16 16

  $hover !checked:
    image-clip: 0 16 16 16

  $checked:
    image-clip: 0 32 16 16
    image-color: #638cffcc

  $hover checked:
    image-clip: 0 48 16 16
    image-color: #638cff

  $disabled:
    image-color: #1a223588
    color: #4b556388
    opacity: 0.8

ColorBox < UICheckBox
  size: 16 16
  image-color: #2a3450
  image-source: /images/ui/colorbox

  $checked:
    image-clip: 16 0 16 16
    image-color: #638cff

  $!checked:
    image-clip: 0 0 16 16

ButtonBox < UICheckBox
  font: verdana-11px-antialised
  color: #e8ecf1
  size: 76 25
  text-offset: 0 0
  text-align: center
  image-source: /images/ui/button
  image-color: #2a3450
  image-clip: 0 0 75 25
  image-border: 10

  $hover !disabled:
    image-clip: 0 25 76 25
    image-color: #334060

  $checked:
    image-clip: 0 50 76 25
    color: #638cff

  $disabled:
    color: #8892a488
    image-color: #1a223588

ButtonBoxRounded < ButtonBox
  image-source: /images/ui/button_rounded