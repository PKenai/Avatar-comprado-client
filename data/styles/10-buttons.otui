Button < UIButton
  font: verdana-11px-antialised
  color: #e8ecf1
  size: 76 23
  text-offset: 0 1
  image-source: /images/ui/button
  image-color: #2a3450
  image-clip: 0 0 75 23
  image-border: 10
  padding: 5 10 5 10
  border-width: 1
  border-color: #ffffff0a

  $hover !disabled:
    image-clip: 0 23 76 23
    image-color: #334060
    border-color: #638cff40

  $pressed:
    image-clip: 0 48 76 23
    text-offset: 1 1
    image-color: #1e2a40

  $disabled:
    color: #8892a488
    image-color: #1a223588

TabButton < UIButton
  size: 25 25
  image-source: /images/ui/tabbutton_rounded
  image-color: #2a3450
  image-clip: 0 0 25 25
  image-border: 5
  icon-color: #8892a4
  color: #8892a4

  $hover !on:
    image-clip: 0 25 25 25
    image-color: #334060
    color: #e8ecf1

  $disabled:
    image-color: #1a223588
    icon-color: #4b556388

  $on:
    image-clip: 0 50 25 25
    image-color: #638cff30
    color: #638cff

TabButtonCh < UIButton
  size: 20 20
  image-color: #8892a4
  image-clip: 0 0 20 40
  image-border: 0

  $hover !on:
    image-clip: 0 40 40 20
    image-color: #e8ecf1

  $disabled:
    image-clip: 0 0 20 20
    image-color: #4b556388

  $on:
    image-clip: 0 40 20 20
    image-color: #638cff

NextButton < UIButton
  size: 12 21
  image-source: /images/ui/arrow_horizontal
  image-clip: 12 0 12 21
  image-color: #8892a4

  $hover !disabled:
    image-clip: 12 21 12 21
    image-color: #e8ecf1

  $pressed:
    image-clip: 12 21 12 21

  $disabled:
    image-color: #4b556388

PreviousButton < UIButton
  size: 12 21
  image-source: /images/ui/arrow_horizontal
  image-clip: 0 0 12 21
  image-color: #8892a4

  $hover !disabled:
    image-clip: 0 21 12 21
    image-color: #e8ecf1

  $pressed:
    image-clip: 0 21 12 21

  $disabled:
    image-color: #4b556388

AddButton < UIButton
  size: 20 20
  image-source: /images/ui/icon_add
  image-color: #8892a4

  $hover !disabled:
    image-color: #e8ecf1

  $pressed:
    image-color: #638cff

  $disabled:
    image-color: #4b556388
