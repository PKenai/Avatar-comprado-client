MoveableTabBar < UIMoveableTabBar
  size: 72 50
MoveableTabBarPanel < Panel
MoveableTabBarButton < UIButton
  size: 72 50
  image-source: /images/ui/tabbutton_square
  image-color: #2a3450
  image-clip: 0 0 50 24
  image-border: 10
  image-border-bottom: 5
  icon-color: #8892a4
  color: #8892a4
  anchors.top: parent.top
  anchors.left: parent.left
  padding: 5

  $hover !checked:
    image-clip: 0 24 50 24
    image-color: #334060
    color: #e8ecf1

  $disabled:
    image-color: #1a223588
    icon-color: #4b556388

  $checked:
    image-clip: 0 48 50 24
    color: #638cff

  $on !checked:
    color: #638cff

TabBar < UITabBar
  size: 80 21
  Panel
    id: buttonsPanel
    anchors.fill: parent
TabBarPanel < Panel
TabBarButton < UIButton
  size: 22 23
  image-source: /images/ui/tabbutton_square
  image-color: #2a3450
  image-clip: 0 0 22 23
  image-border: 3
  image-border-bottom: 0
  icon-color: #8892a4
  color: #8892a4
  anchors.top: parent.top
  padding: 5

  $first:
    anchors.left: parent.left

  $!first:
    anchors.left: prev.right
    margin-left: 5

  $hover !checked:
    image-clip: 0 23 22 23
    image-color: #334060
    color: #e8ecf1

  $disabled:
    image-color: #1a223588
    icon-color: #4b556388

  $checked:
    image-clip: 0 46 22 23
    color: #638cff

  $on !checked:
    color: #638cff


TabBarButtonChat < UIButton
  size: 20 20
  image-color: #2a3450
  image-clip: 0 0 20 20
  image-border: 3
  image-border-bottom: 0
  icon-color: #8892a4
  color: #8892a4
  anchors.top: parent.top
  padding: 5

  $first:
    anchors.left: parent.left

  $!first:
    anchors.left: prev.right
    margin-left: 5

  $hover !checked:
    image-clip: 0 23 22 23
    image-color: #334060
    color: #e8ecf1

  $disabled:
    image-color: #1a223588
    icon-color: #4b556388

  $checked:
    image-clip: 0 46 22 23
    color: #638cff

  $on !checked:
    color: #638cff

TabBarRounded < TabBar
TabBarRoundedPanel < TabBarPanel
TabBarRoundedButton < TabBarButton
  image-source: /images/ui/tabbutton_rounded

TabBarVertical < UITabBar
  width: 96
  ScrollableFlatPanel
    id: buttonsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: scrollBar.left
    anchors.bottom: parent.bottom
    vertical-scrollbar: scrollBar
  VerticalScrollBar
    id: scrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 16
    pixels-scroll: true
    $!on:
      width: 0
TabBarVerticalPanel < Panel
TabBarVerticalButton < UIButton
  size: 48 48
  color: #8892a4
  anchors.left: parent.left
  anchors.right: parent.right
  text-align: bottom
  icon-align: top
  icon-offset-y: 2
  icon-color: #4b5563
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom
    margin-top: 10
  $hover !checked:
    color: #e8ecf1
    icon-color: #8892a4
  $disabled:
    icon-color: #1a2235
  $checked:
    icon-color: #638cff
    color: #638cff
  $on !checked:
    color: #638cff