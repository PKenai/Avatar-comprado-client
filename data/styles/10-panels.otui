Panel < UIWidget
  phantom: true
  auto-focus: first

ScrollablePanel < UIScrollArea
  phantom: true
  auto-focus: first

FlatPanel < Panel
  background-color: #151c2c
  border-width: 1
  border-color: #ffffff0a

ScrollableFlatPanel < ScrollablePanel
  background-color: #151c2c
  border-width: 1
  border-color: #ffffff0a

LightFlatPanel < Panel
  background-color: #1a2235
  border-width: 1
  border-color: #ffffff0a
