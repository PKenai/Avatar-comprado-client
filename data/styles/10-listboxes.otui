TextList < UIScrollArea
  layout: verticalBox
  border-width: 1
  border-color: #ffffff0a
  background-color: #111827
  padding: 1
  auto-focus: none

HorizontalList < UIScrollArea
  layout: horizontalBox
  border-width: 1
  border-color: #ffffff0a
  background-color: #111827

VerticalList < UIScrollArea
  layout: verticalBox
  border-width: 1
  border-color: #ffffff0a
  background-color: #111827