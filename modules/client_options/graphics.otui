Panel
  ButtonBox
    id: opengl1
    anchors.left: parent.left
    anchors.top: parent.top
    text: OpenGL 1
    size: 80 20

  ButtonBox
    id: directx9
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    text: DirectX 9
    size: 80 20
    margin-left: 4

  OptionCheckBox
    id: enableLights
    !text: tr('Enable lights')

  OptionCheckBox
    id: fullscreen
    !text: tr('Fullscreen')
    tooltip: Ctrl+Shift+F

  OptionCheckBox
    id: vsync
    !text: tr('Vertical Sync (VSync)')
    !tooltip: tr('Sync framerate with the monitor to avoid screen tearing')

  OptionCheckBox
    id: hdMode
    !text: tr('HD Mode')
    !tooltip: tr('Upscale sprites with xBRZ (64px). Toggle may reload textures.')

  OptionCheckBox
    id: drawShadows
    !text: tr('Shadows')
    !tooltip: tr('Draw soft shadows under creatures')

  OptionCheckBox
    id: floorShadow
    !text: tr('Floor Shadow')
    !tooltip: tr('Darken underground floors')

  OptionCheckBox
    id: highFloorTransparency
    !text: tr('High Floor Transparency')
    !tooltip: tr('Make upper floors semi-transparent when covering the player')

  Label
    id: floorShadowFadeWidthLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('floorShadowFadeWidth')
      self:setText(tr('Floor shadow fade width: %s px', value))

  OptionScrollbar
    id: floorShadowFadeWidth
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 3
    minimum: 0
    maximum: 128
    !tooltip: tr('Soft gradient on the floor shadow edges (0 disables the fade)')

  Label
    id: floorShadowFadeEasingLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('floorShadowFadeEasing')
      local name = value == 1 and 'Linear' or 'Smoothstep'
      self:setText(tr('Floor shadow fade easing: %s', name))

  OptionScrollbar
    id: floorShadowFadeEasing
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 3
    minimum: 0
    maximum: 1
    !tooltip: tr('0 = Smoothstep (soft), 1 = Linear')

  OptionCheckBox
    id: skyClouds
    !text: tr('Sky Clouds')
    !tooltip: tr('Slow drifting clouds with shadows on roofs and open ground')

  Label
    id: backgroundFrameRateLabel
    !text: tr('Game framerate limit: %s', 'max')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('backgroundFrameRate')
      local text = value
      if value <= 0 or value >= 201 then
        text = 'max'
      end

      self:setText(tr('Game framerate limit: %s', text))

  OptionScrollbar
    id: backgroundFrameRate
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 3
    minimum: 10
    maximum: 201

  Label
    id: foregroundFrameRateLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('foregroundFrameRate')
      local text = value
      if value <= 0 or value >= 61 then
        text = 'max'
      end

      self:setText(tr('Interface framerate limit: %s', text))

  OptionScrollbar
    id: foregroundFrameRate
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 3
    minimum: 1
    maximum: 61

  Label
    id: ambientLightLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    @onSetup: |
      local value = modules.client_options.getOption('ambientLight')
      self:setText(tr('Ambient light: %s%%', value))

  OptionScrollbar
    id: ambientLight
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 3
    minimum: 0
    maximum: 100

