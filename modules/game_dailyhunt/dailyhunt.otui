DailyHuntRow < UIWidget
  height: 82
  phantom: true

  UICreature
    id: creatureIcon
    size: 48 48
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 14 0 0 8

  Label
    id: killCount
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 16 12 0 0
    height: 16
    text-align: right
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #c8c8c8

  Label
    id: monsterName
    anchors.top: parent.top
    anchors.left: creatureIcon.right
    anchors.right: killCount.left
    margin: 16 8 0 8
    height: 16
    text-auto-resize: true
    font: verdana-11px-monochrome
    color: #c8c8c8

  ProgressBar
    id: progressBar
    anchors.top: monsterName.bottom
    anchors.left: creatureIcon.right
    anchors.right: parent.right
    margin: 10 8 0 8
    height: 14
    background-color: #33cc33


DailyHuntWindow < MainWindow
  id: dailyHuntWindow
  size: 360 560
  !text: tr('Daily Hunt')
  visible: false
  padding-top: 16

  @onEscape: modules.game_dailyhunt.onEscape()

  UIButton
    id: closeButton
    size: 14 14
    anchors.top: parent.top
    anchors.right: parent.right
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14
    margin-right: -3
    @onClick: modules.game_dailyhunt.onEscape()

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14

  TextList
    id: monsterList
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: rewardPanel.top
    margin: 40 8 0 8
    phantom: true
    background-color: #00000000
    border-width: 0
    padding: 0
    vertical-scrollbar: scrollBar

  VerticalScrollBar
    id: scrollBar
    anchors.top: monsterList.top
    anchors.bottom: monsterList.bottom
    anchors.left: monsterList.right
    margin-left: 2
    step: 30
    pixels-scroll: true

  UIWidget
    id: rewardPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 44
    margin: 0 8 8 8

    Button
      id: claimButton
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      !text: tr('Resgatar')
      size: 110 28
      @onClick: modules.game_dailyhunt.onClaimReward()

    Button
      id: exitButton
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      !text: tr('Exit')
      size: 70 28
      @onClick: modules.game_dailyhunt.onEscape()
