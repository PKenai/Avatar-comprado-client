StatueBar < UIProgressBar
  height: 16
  image-source: /images/ui/progressbar
  image-border: 1
  font: verdana-11px-rounded
  text-offset: 0 2
  background-color: #666666

// Um card = um alvo de doacao. O card PRECISA ser phantom: false: a style
// "Panel" e' phantom por padrao e, sendo phantom, o engine NUNCA entrega o
// clique no card (recursiveGetChildByPos ignora widget phantom) - era por isso
// que so' dava pra usar a selecao inicial e nao dava pra trocar de nacao.
NationCard < Panel
  id: nationCard
  phantom: false
  focusable: true
  size: 176 150
  // border = "largura cor" (2 partes). Com um "solid" no meio o parser do fork
  // joga OTMLException e ABORTA o resto da style do card (border-color, $focus).
  // Sem background-color: o card nao tem fundo proprio (pedido do dono).
  border: 1 #3a3a3a
  $focus:
    border-color: #ffd479

  UIWidget
    id: cardImage
    size: 44 44
    phantom: true
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6

  Label
    id: cardTitle
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    margin-top: 2
    !text: 'Nation'

  StatueBar
    id: cardBar
    phantom: true
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 6
    margin-right: 6

  Label
    id: cardPool
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    margin-top: 3
    !text: '0 / 150,000'

  Label
    id: cardStatus
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    margin-top: 2
    color: #bdbdbd
    !text: 'Not blessed'

  // text-wrap: o aviso "Your nation (...)" tem quase a largura do card; com
  // wrap ele quebra em 2 linhas em vez de ser cortado nas bordas.
  Label
    id: cardMine
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    text-wrap: true
    margin-bottom: 5
    margin-left: 4
    margin-right: 4
    color: #8fe08f
    !text: ''

GlobalCard < Panel
  id: globalCard
  phantom: false
  focusable: true
  size: 360 110
  border: 1 #3a3a3a
  $focus:
    border-color: #ffd479

  UIWidget
    id: cardImage
    size: 44 44
    phantom: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 6
    margin-left: 8

  Label
    id: cardTitle
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-top: 10
    margin-left: 8
    margin-right: 10
    !text: 'Tab'

  Label
    id: cardCost
    anchors.top: prev.bottom
    anchors.left: prev.left
    anchors.right: parent.right
    margin-top: 2
    margin-right: 10
    color: #ffe9a3
    !text: ''

  // margin-top 12: a descricao comeca ABAIXO do icone (44+6), senao a primeira
  // linha do texto passaria por cima da imagem.
  Label
    id: cardDesc
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    margin-left: 10
    margin-right: 10
    text-wrap: true
    color: #cfcfcf
    !text: ''

  // Barra da aba: com a bencao ativa ela mostra o progresso do TEMPO; inativa
  // mostra o POOL da aba (0 -> meta), igual a barra da nacao.
  StatueBar
    id: cardBar
    phantom: true
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    margin-right: 10

  Label
    id: cardStatus
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    margin-top: 4
    !text: ''

MainWindow
  id: statueWindow
  !text: 'Statue Donation'
  size: 775 470
  @onEscape: modules.statue_donation.hide()

  Label
    id: headerText
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 12
    margin-right: 12
    text-wrap: true
    color: #d8d8d8
    !text: 'Select a card to donate and earn some bonuses'

  Label
    id: goldText
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 12
    color: #28db00
    !text: ''

  Label
    id: targetText
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 12
    color: #ffd479
    !text: ''

  Panel
    id: nationsRow
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    height: 154
    layout:
      type: horizontalBox
      spacing: 6

  Panel
    id: globalsRow
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    height: 114
    layout:
      type: horizontalBox
      spacing: 6

  Label
    id: amountLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 12
    !text: 'Amount (gold)'

  TextEdit
    id: amountInput
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 4
    margin-left: 12
    width: 160
    max-length: 10
    @onKeyPress: modules.statue_donation.onAmountKeyPress()

  Label
    id: amountHint
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 10
    margin-right: 12
    margin-top: 6
    text-wrap: true
    color: #bdbdbd
    !text: ''

  // margin-bottom 0: ancora e' resolvida no PADDING do parent (Window tem
  // padding-bottom 20), entao o botao fica 10px mais baixo que antes e ainda
  // dentro da area util da janela.
  Button
    id: donateButton
    !text: 'Donate'
    width: 150
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 0
    margin-left: 12
    @onClick: modules.statue_donation.donate()

  Button
    id: closeButton
    !text: 'Close'
    width: 110
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin-bottom: 0
    margin-left: 8
    @onClick: modules.statue_donation.hide()
