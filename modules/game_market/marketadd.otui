MainWindow
  size: 340 300
  padding-top: 20
  !text: tr('Adicionar Oferta')
  visible: false

  UIButton
    id: btnClose
    size: 14 14
    anchors.top: parent.top
    anchors.right: parent.right
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14
    margin-right: -3
    @onClick: self:getParent():hide()

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14

  Label
    id: lblItem
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 34 0 0 20
    font: verdana-11px-monochrome
    color: #b8b8b8
    !text: tr('Nome do item:')

  TextEdit
    id: edtItem
    anchors.top: lblItem.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 6 20 0 20
    height: 26
    font: verdana-11px-monochrome

  Label
    id: lblPrice
    anchors.top: edtItem.bottom
    anchors.left: parent.left
    margin: 14 0 0 20
    font: verdana-11px-monochrome
    color: #b8b8b8
    !text: tr('Preço total (gold):')

  TextEdit
    id: edtPrice
    anchors.top: lblPrice.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 6 20 0 20
    height: 26
    font: verdana-11px-monochrome

  Label
    id: lblCount
    anchors.top: edtPrice.bottom
    anchors.left: parent.left
    margin: 14 0 0 20
    font: verdana-11px-monochrome
    color: #b8b8b8
    !text: tr('Quantidade:')

  TextEdit
    id: edtCount
    anchors.top: lblCount.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 6 20 0 20
    height: 26
    font: verdana-11px-monochrome

  Button
    id: buttonCancel
    width: 90
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 0 20 12 0
    !text: tr('Cancelar')
    @onClick: self:getParent():hide()

  Button
    id: buttonOk
    width: 190
    anchors.bottom: parent.bottom
    anchors.right: buttonCancel.left
    margin: 0 6 12 0
    !text: tr('Adicionar')
    @onClick: Market.addOffer()
